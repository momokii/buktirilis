# Committed configuration template: names and safe placeholders only.
# Never put real secrets or personal data here. Runtime .env files are gitignored.

# Local development selector. Allowed: development, staging, production.
# Missing or unknown values select production-safe behaviour (demo off, secure cookies).
APP_ENV=development

# Browser origin used for CORS in development.
PUBLIC_ORIGIN=http://127.0.0.1:5173

# PostgreSQL (compose db service). Fake local-only credentials; replace for a real host.
DATABASE_URL=postgresql+psycopg://buktirilis:buktirilis-dev-only@127.0.0.1:55432/buktirilis

# Deployment-provided key for session/CSRF signing and credential encryption.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required outside development; never commit the real value.
BUKTIRILIS_SECRET_KEY=

# Cookie hardening. Leave unset in development (auto) and set true behind TLS.
COOKIE_SECURE=

# Protected artifact volume (bounded by MAX_ARTIFACT_BYTES).
ARTIFACT_ROOT=./var/artifacts
STRIX_RUNS_ROOT=./var/strix_runs
MAX_ARTIFACT_BYTES=10485760
MAX_OPENAPI_BYTES=2097152
MAX_UPLOAD_BYTES=10485760

# Local demo lab. Loopback targets are only allowed when explicitly enabled.
LAB_BASE_URL=http://127.0.0.1:8099
ALLOW_LOOPBACK_LAB_TARGETS=true
DEMO_SEED_ENABLED=true

# Live Strix execution (worker only). Leave disabled until the boundary is enforced.
LIVE_EXECUTION_ENABLED=false
STRIX_BINARY=strix
STRIX_VERSION=1.7.1
STRIX_MODEL=
STRIX_MAX_BUDGET_USD=2.0
STRIX_MAX_TURNS=40

# Worker lease and queue behaviour.
WORKER_ID=
WORKER_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=2

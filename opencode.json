{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    ".claude/AGENT_RULES.md",
    ".claude/CODING_STANDARDS.md",
    ".claude/SECURITY_STANDARDS.md",
    ".claude/state/CURRENT_STATUS.md"
  ],
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.local": "deny",
      "*.env.development": "deny",
      "*.env.staging": "deny",
      "*.env.production": "deny",
      "*.env.test": "deny",
      "*.env.development.local": "deny",
      "*.env.staging.local": "deny",
      "*.env.production.local": "deny",
      "*.env.test.local": "deny",
      "secrets/*": "deny",
      "*/secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.local": "deny",
      "*.env.development": "deny",
      "*.env.staging": "deny",
      "*.env.production": "deny",
      "*.env.test": "deny",
      "*.env.development.local": "deny",
      "*.env.staging.local": "deny",
      "*.env.production.local": "deny",
      "*.env.test.local": "deny",
      "secrets/*": "deny",
      "*/secrets/*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "*.claude/settings.local.json": "deny"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git branch --show-current": "allow",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny"
    },
    "external_directory": "ask",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow"
  },
  "command": {
    "project-resume": {
      "description": "Run the shared project startup and baseline protocol",
      "template": "Read AGENTS.md and .claude/commands/resume.md. Follow that procedure, report readiness, and wait for confirmation before implementation."
    },
    "project-wrap-up": {
      "description": "Batch shared project state and documentation updates",
      "template": "Read AGENTS.md and .claude/commands/wrap-up.md. Follow that procedure, preserving policies and existing work."
    },
    "project-security-check": {
      "description": "Review current changes against the shared Security Gate",
      "template": "Read AGENTS.md and .claude/commands/security-check.md. Follow that procedure; report findings without automatically fixing them."
    }
  }
}
